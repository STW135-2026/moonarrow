///|
/// The fixture is generated by PyArrow, not by MoonArrow. This makes the test
/// an independent compatibility check against the reference implementation.
async test "reads a PyArrow-generated IPC stream" {
  let bytes = @fs.read_file("fixtures/pyarrow-basic.arrows").binary()
  let decoded = @ipc.read_stream(bytes)
  guard decoded is Ok(stream) else {
    guard decoded is Err(error) else { fail("unexpected IPC result") }
    fail("PyArrow stream should decode: \{Repr(error)}")
  }
  let schema = stream.schema()
  assert_eq(schema.len(), 6)
  assert_eq(schema.fields(), [
    @types.Field::new("city", @types.Utf8, nullable=false),
    @types.Field::new("temperature_c", @types.Int32),
    @types.Field::new("active", @types.Boolean),
    @types.Field::new("score", @types.Float64),
    @types.Field::new("sequence", @types.Int64),
    @types.Field::new("payload", @types.Binary),
  ])
  assert_eq(stream.batch_count(), 1)
  guard stream.batch(0) is Some(batch) else { fail("batch should exist") }
  assert_eq(batch.row_count(), 4)
  guard batch.column_by_name("city") is Some(@record_batch.Utf8(city)) else {
    fail("city should be UTF-8")
  }
  assert_eq(city.to_options(), [
    Some("Shenzhen"),
    Some("Paris"),
    Some("Unknown"),
    Some("Tokyo"),
  ])
  guard batch.column_by_name("temperature_c")
    is Some(@record_batch.Int32(temperature)) else {
    fail("temperature should be int32")
  }
  assert_eq(temperature.to_options(), [Some(31), Some(19), None, Some(27)])
  guard batch.column_by_name("active") is Some(@record_batch.Bool(active)) else {
    fail("active should be bool")
  }
  assert_eq(active.to_options(), [Some(true), None, Some(false), Some(true)])
  guard batch.column_by_name("score") is Some(@record_batch.Float64(score)) else {
    fail("score should be float64")
  }
  assert_eq(score.to_options(), [Some(9.5), None, Some(-1.25), Some(7.0)])
  guard batch.column_by_name("sequence") is Some(@record_batch.Int64(sequence)) else {
    fail("sequence should be int64")
  }
  assert_eq(sequence.to_options(), [
    Some(4_294_967_296L),
    None,
    Some(-9_223_372_036_854_775_000L),
    Some(7L),
  ])
  guard batch.column_by_name("payload") is Some(@record_batch.Binary(payload)) else {
    fail("payload should be binary")
  }
  assert_eq(payload.to_options(), [
    Some(b"\x00\xff"),
    None,
    Some(b"MoonArrow"),
    Some(b""),
  ])
}

///|
async test "rejects a truncated PyArrow stream" {
  let bytes = @fs.read_file("fixtures/pyarrow-basic.arrows").binary()
  guard bytes.get_view(start=0, end=bytes.length() - 1) is Some(prefix) else {
    fail("fixture should contain a non-empty stream")
  }
  assert_true(@ipc.read_stream(prefix.to_owned()) is Err(_))
}

///|
async test "rejects invalid UTF-8 in a PyArrow string column" {
  let bytes = @fs.read_file("fixtures/pyarrow-basic.arrows").binary()
  let corrupted = bytes.to_array()
  let city_offset = find_bytes(corrupted, b"Shenzhen")
  guard city_offset is Some(offset) else {
    fail("fixture should contain the first city value")
  }
  corrupted[offset] = b'\xff'
  assert_true(
    @ipc.read_stream(Bytes::from_array(corrupted))
    is Err(@ipc.InvalidUtf8(_, _)),
  )
}

///|
fn find_bytes(haystack : Array[Byte], needle : Bytes) -> Int? {
  let target = needle.to_array()
  let mut start = 0
  while start + target.length() <= haystack.length() {
    let mut matched = true
    let mut index = 0
    while index < target.length() {
      if haystack[start + index] != target[index] {
        matched = false
      }
      index = index + 1
    }
    if matched {
      return Some(start)
    }
    start = start + 1
  }
  None
}
